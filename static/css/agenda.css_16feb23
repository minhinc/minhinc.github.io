/** {margin:0px;padding:0px;font-family:mytwcenmt,mybembo; font-size:13pt;color:#000; text-decoration:none;}
html{overflow:scroll;}
body {width:860;margin:0 auto;background-color:#fff;}*/
/*pg, every page*/
div.pg {border:1px solid blue;position:relative;page-break-after:always;page-break-inside:avoid;}
/*div.pg {position:relative;}*/
div.pg h2{display:inline;}
div.pg hr{float:left;width:100%;color:#888888}
div.pg pre {white-space:pre-wrap;}
div.pg a{color:#0000aa;font-size:13pt;font-family:mytwcenmt;text-decoration:none}
div.pg pre.ftr{position:absolute;bottom:0px;left:45%;color:#004000;font-family:mytwcenmt;font-size:8pt}
div.pg pre.pn{position:absolute;bottom:0px;right:0px;color:#040;font-family:mytwcenmt;font-size:8pt}
div.pg a.pn{position:absolute;bottom:0px;right:0px;color:#040;font-family:mytwcenmt;font-size:8pt}
div.pg div.clr {clear:both;}
div.pg span.dot {height:8px;width:8px;border-radius:50%;vertical-align:middle;display:inline-block;}
div.pg span.dot1 {height:7px;width:7px;border-radius:50%;vertical-align:middle;display:inline-block;}
div.pg span.dot2 {height:6px;width:6px;border-radius:50%;vertical-align:middle;display:inline-block;}

div.pg a.logo{position:absolute;width:100%;top:50%;text-align:center}
div.pg a.logo pre {position:relative;font-family:'Tw Cen MT';color:#040;width:420px;font-size:56px;margin-left:auto;margin-right:auto;}
div.pg a.logo pre span{position:absolute;font-family:'Tw Cen MT';color:#888;font-size:16pt;top:10px;left:1px;}
div.pg img.logo{position:absolute;top:44%;left:64%;}
/*div.pg pre.logot{position:absolute;top:46%;left:44%;font-family:mytwcenmt;color:#040;font-size:48pt}
div.pg pre.logob{position:absolute;top:51%;left:40.4%;font-family:mytwcenmt;color:#888;font-size:9pt}
div.pg img.logo{position:absolute;top:46%;left:57.6%;}*/

div.pg pre.title{text-align:center;font-size:24pt;font-weight:bold;}
div.pg pre.subtitle{text-align:center;font-size:18pt;}
/*div.pg pre.company{text-align:center;font-size:16pt;margin-bottom:100px;color:#004000;font-family:mytwcenmt}*/
div.pg pre.company{text-align:center;font-size:16pt;color:#004000;font-family:mytwcenmt}
div.pg div.headerleft{float:left;background-color:#c9c6ff;height:100%;width:24.9%;font-weight:bold;font-size:16pt;}
div.pg div.headerright{float:right;background-color:#eaebff;height:100%;width:74.9%;}
div.pg div.headerleft > pre{font-size:16pt;padding:10 0 0 10;font-family:mytwcenmt}
div.pg div.headerright > pre{padding:10 0 0 10;font-family:mytwcenmt}

div.pg div.header2 pre.header {background-color:#c9c6ff;font-size:16pt;font-weight:bold;font-family:mytwcenmt;padding-left:10px;}
div.pg div.header2 pre.content {background-color:#eaebff;padding:10 0 0 10;font-family:mytwcenmt}

div.pg div.dayheader {float:left;width:100%}
div.pg div.dayheader pre{margin-left:5px;font-family:mytwcenmt;font-size:26px;font-weight:bold;color:#396986;}
div.pg div.dayheader hr{margin-top:20px}

div.pg div.dayheaderleft {clear:both;float:left;width:50%;}
div.pg div.dayheaderright {float:right;width:50%;}
div.pg div.dayheaderheader {background-color:#c9c6ff;width:100%;}
div.pg div.dayheaderheaderlab {background-color:#719476;width:100%;}
div.pg div.dayheaderheader pre,div.pg div.dayheaderheaderlab pre{font-weight:bold;font-size:11pt;}
div.pg div.dayheaderheader pre{font-weight:bold;font-size:11pt;}
div.pg div.dayheaderheader a{display:block;font-weight:bold;color:#000;padding:8px 0 0 5px;width:99%;font-size:11pt;font-family:Verdana, Arial, Geneva, sans-serif;}
div.pg ul.daycontent {background-color:#eaebff;padding-top:10px;width:99.7%;}
div.pg ul.daycontent li{margin-left:45px;font-size:11pt;list-style:disc}
div.pg ul.daycontent li pre{font-size:13pt;font-family:mytwcenmt}
div.pg ul.daycontent li a{color:#000000;font-size:13pt;display:block;font-family:mytwcenmt}
div.pg ul.daycontent li a:hover {background-color:#ffaa00}

div.pg pre.slidetitle {text-align:center;margin-top:30%;font-family:mytwcenmt;font-size:72pt;color:#004000}
div.pg pre.slidesubtitle {text-align:center;font-family:mytwcenmt;font-size:24pt;color:#004000}
div.pg pre.slidecompanytitle{margin-top:30%;font-size:46pt;font-family:mytwcenmt;text-align:center;color:#004000}
div.pg pre.slidedisclaimer {margin-top:20%;margin-left:20px;font-family:mybembo;font-size:8pt;}
div.pg div.slideheader {float:left;width:45%;margin-bottom:6px;}
div.pg div.slideheader pre.day {width:100%;background-color:#c9c6ff;line-height:42px;font-weight:bold;font-size:14pt;text-align:center;}
div.pg div.slideheader pre.topic {width:99.99%;background-color:#eaebff;line-height:32px;font-weight:bold;font-size:14pt;color:#004000}
div.pg div.slideheader ul.slidecontent {background-color:#eaebff;width:99.99%;}
div.pg div.slideheader ul.slidecontent li.big{margin-left:45px;font-size:13pt;list-style:disc;}
div.pg div.slideheader ul.slidecontent li.sml{margin-left:45px;font-size:4pt;list-style:disc}
div.pg div.slideheader ul.slidecontent li.big pre{font-size:13pt;font-family:mybembo}
div.pg div.slideheader ul.slidecontent li.big a{color:#000000;font-size:13pt;font-family:mybembo}
div.pg div.slideheader ul.slidecontent li.sml pre{font-size:3pt;font-family:mybembo}
div.pg pre.slideabstract{ float:right;width:53%;padding-top:40px;font-size:10pt;font-style:Italic;font-family:mybembo;}
div.pg pre.slidecontent {font-size:13pt;font-family:mytwcenmt;display:inline-block;max-width:60%}
div.pg pre.slidecontent span {font-size:13pt;font-family:mytwcenmt;}
div.pg pre.slidecontent pre.note {font-size:13pt;padding:2px 0px 8px 8px;border-radius:5px;font-family:mytwcenmt;background-color:#bcd4ff;color:#000000;display:inline-block}
div.pg pre.code {font-size:10pt;font-family:myconsolas;display:inline-block;max-width:70%;margin:4px 0px;}
div.pg pre.code span {font-size:10pt;font-family:myconsolas;}
div.pg pre.codeb {font-size:9pt;font-family:myconsolas;background-color:#eeeeee;display:inline-block;margin:4px 0px;padding:10px;max-width:70%}
div.pg pre.codeb span {font-size:9pt;font-family:myconsolas;}
div.pg pre.codei,div.pg pre.codei span {font-size:10pt;font-family:myconsolas;display:inline}
div.pg pre.codec{font-size:6pt;font-family:myconsolas;max-width:70%;display:inline-block;}
div.pg pre.codec span{font-size:6pt;font-family:myconsolas;}
div.pg pre.codeci, div.pg pre.codeci span{font-size:6pt;font-family:myconsolas;display:inline}
div.pg pre.codes{font-size:6pt;float:left;font-family:myconsolas; -webkit-box-shadow: inset 1px 1px 1px 0px rgba(0,0,0,0.75); -moz-box-shadow: inset 1px 1px 1px 0px rgba(0,0,0,0.75); box-shadow: inset 1px 1px 1px 0px rgba(0,0,0,0.75); padding: 5px 0 0 2px; background: #eee; -webkit-border-radius: 10px; -moz-border-radius: 10px; border-radius: 10px;max-width:49%;}
div.pg pre.slidecontent b{font-family:mytwcenmt}
div.pg pre.slidecontent pre.blue{color:#447777;font-weight:bold;display:inline;}
div.pg pre.slidecontent pre.black{color:#000;font-weight:bold;display:inline;}

div.pg pre.articleheadermaintopic {color:#000000;font-size:16pt;margin-top:30px;width:70%;font-family:mytwcenmt}
div.pg pre.articleheadersubtopic {margin-left:6px;margin-top:2px;width:70%;}
div.pg pre.articleheadersubtopic span.articleheadersubtopic {display:inline;color:#111111;font-size:14pt;margin-left:8px;font-family:mytwcenmt}
div.pg pre.articleheadersubtopic span.articleheadersubsubtopic {display:inline;color:#222222;font-size:12pt;margin-left:4px;font-family:mytwcenmt}

div.pg pre.articlecontentmaintopic {text-align:center;margin:auto;font-size:24pt;font-family:myavenir}
div.pg pre.articlecontentabstract {text-align:center;font-family:myavenir;font-size:16pt;margin:auto;max-width:50%;font-style:italic;}
div.pg div.articledivleft {float:left;width:48%;border:1px solid red}
div.pg div.articledivright {float:right;width:48%;border:1px solid blue;}
div.pg div.articledivleft pre.articlecontentsubtopic, div.pg div.articledivright pre.articlecontentsubtopic {font-weight:bold;color:#2a3e92;font-family:myavenir}
div.pg div.articledivleft pre.articlecontentsubsubtopic, div.pg div.articledivright pre.articlecontentsubsubtopic {color:#364998;font-family:myavenir}
div.pg div.articledivleft pre.slidecontent, div.pg div.articledivright pre.slidecontent {max-width:100%;font-family:mygaramond}
div.pg div.articledivleft pre.code, div.pg div.articledivright pre.code {max-width:100%;}
div.pg div.articledivleft pre.codec, div.pg div.articledivright pre.codec {max-width:100%;font-family:mygaramond}
div.pg div.articledivleft pre.img, div.pg div.articledivright pre.img {max-width:100%}

div.pg div.pagetop {margin:-1px -1px 0;background:#4562b7;}
.crsAd{margin:2em 7%;border:1px solid #3777ad;border-radius:0.5em;font-size:0.9em;background:#f5ffff}
p.adHd{margin:-1px -1px 0;background:#14448b;border-top-left-radius:0.5em;border-top-right-radius:0.5em;color:#fff;padding:0.3em;font-weight:bold}
.flx{display:flex}
.crsAd div{margin:0 0.5em}
.crsAd .flx:first-child div:first-child{min-width:110px;padding-top:0.5em}
.crsAd div p:first-child{margin-top:0.5em}
.kurses div{display:inline-block;width:220px}
.fixWidth{font-family:monospace}
